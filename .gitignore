# ==========================================
# IELTS Practice Platform - .gitignore
# ==========================================

# Secrets & Environment Variables (NEVER COMMIT)
*.env
*.env.*
!.env.example
listening/backend/.env

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Flutter / Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
build/
**/build/
listening/build/
listening/.dart_tool/
listening/.flutter-plugins
listening/.flutter-plugins-dependencies
listening/.pub-cache/
listening/.pub/

# Android Studio / IntelliJ / VS Code
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.swp
*.bak
*~

# Windows ephemeral & flutter builds
windows/flutter/ephemeral/
listening/windows/flutter/ephemeral/
*.pdb
*.obj
*.tlog
*.log

# macOS / iOS
.DS_Store
.AppleDouble
.LSOverride
**/ios/Flutter/.last_build_id
**/ios/.symlinks/

# Android build outputs
android/app/debug/
android/app/profile/
android/app/release/
listening/android/app/debug/
listening/android/app/profile/
listening/android/app/release/

# Coverage & symbols
coverage/
app.*.symbols
app.*.map.json
.widget_preview/

# Temporary / Scratch
scratch/
listening/scratch/


# Reference PDFs
*.pdf
